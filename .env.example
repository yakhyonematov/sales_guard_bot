# Environment Configuration
NODE_ENV=development
PORT=3000

# Telegram Bot
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Super Admin Telegram IDs (comma-separated, e.g. 12345678,98765432)
SUPER_ADMIN_TELEGRAM_IDS=123456789

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/okk_penalty_bot?schema=public"

# System Settings
TIMEZONE=Asia/Tashkent
DEFAULT_TRAINING_THRESHOLD=2
STAFF_CAN_REVOKE_OTHERS=false

# Webhook (optional, false for long-polling in development)
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com/telegram/webhook
WEBHOOK_SECRET=your_secret_token
